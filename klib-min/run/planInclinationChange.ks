{local A is import("mnv/changeInclinationAtNode-v1"),C is import("run/onFail"),B is{parameter B,D,F,G.until not hasNode{remove nextNode. wait 0.}dmsg("Planning plane change",true,true).local A is B(D,F).C:shutdown(A,"Plane change").add A:val. G:next().}.export(lex("AN",B:bind(A:AN),"DN",B:bind(A:DN),"next",B:bind(A:next),"last",B:bind(A:last),"highest",B:bind(A:highest),"lowest",B:bind(A:lowest))).}