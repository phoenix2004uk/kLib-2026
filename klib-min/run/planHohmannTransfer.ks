{local B is import("mnv/hohmannTransfer-v1"),H is import("run/onFail"),D is"Transfer encounters ",F is"Encounter confirmed - Coasting to ".export({parameter A,I.until not hasNode{remove nextNode. wait 0.}dmsg("Planning transfer to "+A:name,true,true).local G is B(A):val. add G. local C is{parameter A.H:reboot(60,A,"Hohmann transfer").},B is G:obt. if A:isType("Body"){if not B:hasNextPatch C("Transfer does not encounter "+A:name).if B:nextPatch:body<>A C(D+B:nextPatch:body:name).dmsg(F+A:name+" SOI",true,true).}if A:isType("Vessel"){if B:hasNextPatch and B:nextPatchEta<B:period/2C(D+B:nextPatch:body:name+" before target intercept").dmsg(F+A:name+" intercept",true,true).}I:next().}).}