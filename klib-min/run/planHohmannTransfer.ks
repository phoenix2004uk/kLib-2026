{local B is import("mnv/hohmannTransfer-v1"),H is import("prg/executeNode-v1"),G is import("run/onFail"),F is"Transfer encounters ".export({parameter A,I.until not hasNode{remove nextNode. wait 0.}dmsg("Planning transfer to "+A:name,true,true).local C is B(A):val. add C. local D is{parameter A.G:reboot(60,A,"Hohmann transfer").},B is C:obt. if H:burnDuration(C:deltaV:mag/2)>C:eta-60D("Departure burn too soon").if A:isType("Body"){if not B:hasNextPatch D("Transfer does not encounter "+A:name).if B:nextPatch:body<>A D(F+B:nextPatch:body:name).}if A:isType("Vessel")and B:hasNextPatch and B:nextPatchEta<B:period/2D(F+B:nextPatch:body:name+" before target intercept").dmsg("Encounter confirmed with "+A:name,true,true).I:next().}).}