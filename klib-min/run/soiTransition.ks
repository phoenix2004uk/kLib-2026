{export(lex("warpTo",{parameter B.if warpMode="PHYSICS"{kuniverse:timewarp:cancelWarp().wait until kuniverse:timewarp:isSettled.}local A is time:seconds+eta:transition. if warp=0and time:seconds<A-30warpTo(A).B:next().},"await",{parameter B,A.if body=B{local B is time:seconds. kuniverse:timewarp:cancelWarp().wait until kuniverse:timewarp:isSettled and time:seconds>B+10.dmsg("Entered "+body:name+" SOI",true,true).A:next().}})).}