{local I is import("tlm/altitudeSafety-v1"),J is import("mnv/changeFlybyPe-v1"),F is import("run/onFail"),C is import("util/format-v1").export({parameter B,G,H,D.until not hasNode{remove nextNode. wait 0.}dmsg("Trimming "+body:name+" approach",true,true).local A is B. if H{local D is I:altitude(body).F:shutdown(D,"Approach trim","Terrain height check").set A to max(B,D:val+100).dmsg("     Minimum Pe = "+C:distance(B),true).dmsg("    Terrain max = "+C:distance(D:val),true).dmsg("    Targeted Pe = "+C:distance(A),true).}D:share("targetedFlybyPeriapsis",A).local C is J(A,G).F:shutdown(C,"Approach trim").add C:val. D:next().}).}