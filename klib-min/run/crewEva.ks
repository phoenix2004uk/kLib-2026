export(lex("begin",{parameter A.dmsg("Awaiting crew egress",true).A:share("crewComplement",ship:crew():length).A:next().},"egress",{parameter A.if ship:crew():length<A:fetch("crewComplement"){dmsg("Crew egress detected - Awaiting crew return",true,true).A:next().}},"ingress",{parameter A.if ship:crew():length=A:fetch("crewComplement"){dmsg("Crew ingress complete",true,true).A:next().}})).