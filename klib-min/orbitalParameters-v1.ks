{local A is import("math-v1"),B is constant:radToDeg. function C{parameter Z,Y is orbit:semimajoraxis,X is orbit:eccentricity. return(Y*(1-X^2))/(1+X*cos(Z)).}export(lex("a",{parameter Z,Y,X is body. if Z<0 or Y<0 print"Error: SemiMajorAxis is only valid for elliptical orbits".return(Z+Y)/2+X:radius.},"Vlim",{parameter Z is orbit:eccentricity. if Z<1 return 180. return arccos(max(-1,-1/Z)).},"Van",{parameter Z is orbit:argumentOfPeriapsis,Y is orbit:eccentricity. if Y<1 return mod(360-Z,360).return -Z.},"Vdn",{parameter Z is orbit:argumentOfPeriapsis,Y is orbit:eccentricity. if Y<1 return mod(540-Z,360).return 180-Z.},"Vr",C@,"Vh",{ parameter Z,Y is orbit:semimajoraxis,X is orbit:eccentricity,W is body. return C(Z,Y,X)-W:radius.},"E",{parameter Z,Y is orbit:eccentricity. if Y>=1 print"Error: EccentricAnomaly is only valid for elliptical orbits".local X is mod(Z + 360, 360),W is arccos((Y+cos(X))/(1+Y*cos(X))).if X>180 set W to 360-W. return W.},"F",{parameter Z,Y is orbit:eccentricity. if Y<=1 print"Error: HyperbolicAnomaly is only valid for hyperbolic orbits".local X is A:acosh((Y+cos(Z))/(1+Y*cos(Z)))*B. if Z<0 return -X. return X.},"M",{parameter Z,Y is orbit:eccentricity. if Y>=1 print"Error: MeanAnomaly is only valid for elliptical orbits".return Z-Y*sin(Z)*B.},"Mh",{parameter Z,Y is orbit:eccentricity. if Y<=1 print"Error: HyperbolicMeanAnomaly is only valid for hyperbolic orbits".local X is Z*constant:degToRad. return(Y*A:sinh(X)-X)*B.})).}