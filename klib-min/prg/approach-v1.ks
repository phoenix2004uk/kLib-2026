{local A is import("sys/steering-v1"):awaitSteering,B is{parameter Z,Y. local lock U to Z:velocity:orbit-velocity:orbit+Z:position:normalized*Y. lock steering to U. A().lock throttle to choose 0 if ship:availableThrust=0 else min(1,min(1,U:mag/2)*mass/ship:availableThrust).wait until U:mag<.1.lock throttle to 0.unlock steering. unlock U.}.export({parameter Z,W,Y. until Z:distance<=W{B(Z,Y).wait until Z:distance<=W or vdot(Z:position,Z:velocity:orbit-velocity:orbit)>=0.B(Z,0).wait 0.}}).}