{local A is import("sys/steering-v1"):awaitSteering,B is{parameter Z,Y. return Z:velocity:orbit-velocity:orbit+Z:position:normalized*Y.},C is{parameter Z,Y. local lock W to B(Z,Y).lock steering to W. A().lock throttle to choose 0 if ship:availableThrust=0 else min(1,min(1,W:mag/2)*mass/ship:availableThrust).wait until W:mag<.1.lock throttle to 0.unlock steering.}.export({parameter Z,X,Y. until Z:distance<=X{C(Z,Y).lock steering to B(Z,0).wait until Z:distance<=X or vdot(Z:position,Z:velocity:orbit-velocity:orbit)>=0.C(Z,0).lock steering to B(Z,Y).wait 0.}}).}