{local A is import("sys/steering-v1"):awaitSteering. function B{parameter Z,Y is stage:number. local X is 0,T is 0,S is 0,P is 0. for U in ship:parts if U:stage<=Y set X to X+U:mass. for O in ship:engines if(Y<stage:number and O:stage=Y)or(Y=stage:number and O:ignition and not O:flameout){set T to T+O:possiblethrustat(ship:q).set S to S+O:ispat(ship:q).set P to P+1.}if P>0 set S to S/P. if T=0 or S=0 return 0. return constant:g0*X*S*(1-constant:e^(-abs(Z)/(constant:g0*S)))/T.}export(lex("burnDuration",B@,"warpToNode",{parameter Z is 60. if not hasnode return. warpTo(time:seconds+nextnode:eta-B(nextnode:deltav:mag/2)-Z).},"executeNode",{parameter Z is 60. if not hasnode return. local Y is nextnode,X is B(Y:deltav:mag/2).wait until Y:eta<=X+Z. kuniverse:timewarp:cancelwarp().wait until kuniverse:timewarp:issettled. lock steering to Y:burnvector. A().local U is Y:deltav. wait until Y:eta<=X. lock throttle to max(1e-3,min(Y:deltav:mag*mass/availablethrust,1)).wait until vdot(U,Y:deltav)<0 or(Y:deltav:mag<1e-2 and vdot(U,Y:deltav)<0.5).lock throttle to 0. unlock steering. wait 0.1. remove Y.})).}