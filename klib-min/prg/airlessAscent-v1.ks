{local D is import("sys/staging-v1"):autostage,C is import("sys/steering-v1"):awaitSteering. export({parameter H,I.local B is false,A is false,J is ship:bounds,F is 0,G is pidLoop(3,0,.1,0,90,1).sas off.lock steering to up:vector. lock throttle to 1.until(J:bottomAltRadar>=10and eta:apoapsis>=15)or A{if stage:number=0and availableThrust=0set A to true. D().wait 0.}if not A{gear off.local lock C to choose eta:apoapsis if eta:apoapsis<eta:periapsis else eta:apoapsis-obt:period. lock steering to heading(H,F).set G:setpoint to 30.until(apoapsis>=I and C>=10)or B or A{if status="LANDED"or status="SPLASHED"set B to true. if stage:number=0and availableThrust=0set A to true. set F to G:update(time:seconds,C).D().wait 0.}unlock C.}lock throttle to 0.if B{unlock steering.wait until not steeringManager:enabled and groundSpeed<1and abs(verticalSpeed)<1.wait 1.sas on.dmsg("Crashed back into the surface",true).return"CRASHED".}else if A{unlock steering.dmsg("We ran out of fuel",true).return"NO_FUEL".}else{lock steering to prograde. C().dmsg("Ready to circularize at Apoapsis",true).return status.}}).}