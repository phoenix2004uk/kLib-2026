{local A is import("sys/staging-v1"):autostage,B is import("sys/steering-v1"):awaitSteering. export({parameter Z,Y. local X is false,W is false,U is ship:bounds,T is 0,S is pidLoop(3,0,.1,0,90,1).sas off. lock steering to up:vector. lock throttle to 1.until(U:bottomAltRadar>=10 and eta:apoapsis>=15)or W{if stage:number=0 and availableThrust=0 set W to true. A().wait 0.}if not W{gear off. local lock P to choose eta:apoapsis if eta:apoapsis<eta:periapsis else eta:apoapsis-obt:period. lock steering to heading(Z,T).set S:setpoint to 30.until(apoapsis>=Y and P>=10)or X or W{if status="LANDED"or status="SPLASHED"set X to true. if stage:number=0 and availableThrust=0 set W to true. set T to S:update(time:seconds,P).A().wait 0.}unlock P.}lock throttle to 0.if X{unlock steering. wait until not steeringManager:enabled and groundSpeed<1 and abs(verticalSpeed)<1.wait 1.sas on. dmsg("Crashed back into the surface",true).return"CRASHED".}else if W{unlock steering. dmsg("We ran out of fuel",true).return"NO_FUEL".}else{lock steering to prograde. B().dmsg("Ready to circularize at Apoapsis",true).return status.}}).}