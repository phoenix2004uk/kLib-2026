{export({local A is throttle,B is A,C is time:seconds. return lex("current",{local D is time:seconds,F is.3*(D-C).set C to D,B to max(B-F,min(B+F,A)).return B.},"setTarget",{parameter B.set A to max(0,min(1,B)).},"target",{return A.},"reset",{parameter D is throttle. set A to max(0,min(1,D)),B to A,C to time:seconds.}).}).}