{local A is list(0,0,0),B is{parameter Z,Y. if not rcs{set A to list(0,0,0).return 0.}if abs(Z)<1e-9{set A[Y]to 0.return 0.}if abs(Z)>=.05{set A[Y]to 0.return Z.}set A[Y]to A[Y]+Z/.05.if A[Y]>=1{set A[Y]to A[Y]-1.return .05.}if A[Y]<=-1{set A[Y]to A[Y]+1.return-.05.}return 0.},C is{set A to list(0,0,0).set ship:control:translation to V(0,0,0).},D is{parameter Z,Y is 1.if Z:mag<1e-9{C().return.}local X is max(0,min(1,Y))*Z:normalized,W is V(X*facing:starvector,X*facing:upvector,X*facing:vector).set ship:control:translation to V(B(W:x,0),B(W:y,1),B(W:z,2)).}.export(lex("translate",D,"zero",{parameter Z. local Y is Z. if Z:hassuffix("ship")set Y to Z:ship. local X is Y:velocity:orbit-ship:velocity:orbit. until X:mag<.05{D(X,X:mag/.5).wait 0.set X to Y:velocity:orbit-ship:velocity:orbit.}C().},"off",C)).}