{local A is list(0,0,0),C is{parameter C,B.if not rcs{set A to list(0,0,0).return 0.}if abs(C)<1e-9{set A[B]to 0.return 0.}if abs(C)>=.05{set A[B]to 0.return C.}set A[B]to A[B]+C/.05.if A[B]>=1{set A[B]to A[B]-1.return.05.}if A[B]<=-1{set A[B]to A[B]+1.return-.05.}return 0.},B is{set A to list(0,0,0),ship:control:translation to V(0,0,0).},F is{parameter D,F is 1.if D:mag<1e-9{B().return.}local A is max(0,min(1,F))*D:normalized,B is V(A*facing:starvector,A*facing:upvector,A*facing:vector).set ship:control:translation to V(C(B:x,0),C(B:y,1),C(B:z,2)).}.export(lex("translate",F,"zero",{parameter C.local D is C. if C:hassuffix("ship")set D to C:ship. local A is D:velocity:orbit-velocity:orbit. until A:mag<.05{F(A,A:mag/.5).wait 0.set A to D:velocity:orbit-velocity:orbit.}B().},"off",B)).}