{local A is import("mech/orbitalParameters-v1"),D is{parameter B is altitude,C is obt:semimajoraxis,A is body. return sqrt(A:mu*(2/(B+A:radius)-1/C)).},F is{parameter A is obt:semimajoraxis,B is body. if A<=0print"Error: OrbitalPeriod is only valid for elliptical orbits".return 2*constant:pi*sqrt(A^3/B:mu).},C is{parameter D,C is obt:period,F is obt:trueanomaly,B is obt:eccentricity. if B<1{local A is mod(360+A:M(A:E(D,B),B)-A:M(A:E(F,B),B),360).if A<1e-9or 360-A<1e-9set A to 0.return C*A/360.}print"Error: TrueAnomalyEta is only valid for elliptical orbits".return false.},B is{parameter F,G is obt:trueanomaly,C is obt:semimajoraxis,B is obt:eccentricity,D is body. if B>1{local A is A:Mh(A:F(F,B),B)-A:Mh(A:F(G,B),B).if abs(A)<1e-9set A to 0.return A/(sqrt(D:mu/(-C)^3)*constant:radToDeg).}print"Error: TrueAnomalyEtaHyperbolic is only valid for hyperbolic orbits.".return false.}.export(lex("v",D,"vh",{parameter C,F,G,B is body. return D(C,A:a(F,G,B),B).},"Ve",{parameter A is body,B is altitude. return sqrt(2*A:mu/(B+A:radius)).},"P",F,"Ph",{parameter C,D,B is body. return F(A:a(C,D,B),B).},"h",{parameter A.return vcrs(A:position-A:body:position,A:velocity:orbit).},"hAt",{parameter A,B.return vcrs(positionAt(A,B)-A:body:position,velocityAt(A,B):orbit).},"etaV",C,"dtV",{parameter C,G is obt:period,F is obt:trueanomaly,B is obt:eccentricity. if B<1{local D is choose ceiling(C/360)if C<0else floor(C/360),C is C-D*360,A is A:M(A:E(mod(360+F+C,360),B),B)-A:M(A:E(F,B),B).if C>0and A<0set A to A+360.if C<0and A>0set A to A-360.return G*(D+A/360).}print"Error: TrueAnomalyArcTime is only valid for elliptical orbits".return false.},"etaAN",{parameter D is obt:argumentOfPeriapsis,F is obt:period,G is obt:trueanomaly,B is obt:eccentricity. return C(A:Van(D,B),F,G,B).},"etaDN",{parameter D is obt:argumentOfPeriapsis,F is obt:period,G is obt:trueanomaly,B is obt:eccentricity. return C(A:Vdn(D,B),F,G,B).},"etaVh",B,"etaANh",{parameter D is obt:argumentOfPeriapsis,F is obt:trueanomaly,G is obt:semimajoraxis,C is obt:eccentricity,H is body. return B(A:Van(D,C),F,G,C,H).},"etaDNh",{parameter D is obt:argumentOfPeriapsis,F is obt:trueanomaly,G is obt:semimajoraxis,C is obt:eccentricity,H is body. return B(A:Vdn(D,C),F,G,C,H).})).}