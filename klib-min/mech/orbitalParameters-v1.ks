{local D is import("util/math-v1"),A is constant:RadToDeg,B is{parameter B,C is obt:semimajoraxis,A is obt:eccentricity. return(C*(1-A^2))/(1+A*cos(B)).}.export(lex("a",{parameter A,B,C is body. if A<0or B<0print"Error: SemiMajorAxis is only valid for elliptical orbits".return(A+B)/2+C:radius.},"Vlim",{parameter A is obt:eccentricity. if(A<1)return 180.return arccos(max(-1,-1/A)).},"Van",{parameter A is obt:argumentOfPeriapsis,B is obt:eccentricity. if B<1return mod(360-A,360).return-A.},"Vdn",{parameter A is obt:argumentOfPeriapsis,B is obt:eccentricity. if B<1return mod(540-A,360).return 180-A.},"Vr",B,"Vh",{parameter A,C is obt:semimajoraxis,D is obt:eccentricity,F is body. return B(A,C,D)-F:radius.},"E",{parameter D,A is obt:eccentricity. if A>=1print"Error: EccentricAnomaly is only valid for elliptical orbits".local B is mod(D+360,360),C is arccos((A+cos(B))/(1+A*cos(B))).if(B>180)set C to 360-C. return C.},"F",{parameter B,C is obt:eccentricity. if C<=1print"Error: HyperbolicAnomaly is only valid for hyperbolic orbits".local A is D:acosh((C+cos(B))/(1+C*cos(B)))*A. if B<0return-A. return A.},"M",{parameter B,C is obt:eccentricity. if C>=1print"Error: MeanAnomaly is only valid for elliptical orbits".return B-C*sin(B)*A.},"Mh",{parameter F,B is obt:eccentricity. if B<=1print"Error: HyperbolicMeanAnomaly is only valid for hyperbolic orbits".local C is F*constant:degToRad. return(B*D:sinh(C)-C)*A.})).}