{local D is import("util/math-v1"),C is 1e-9,A is constant:RadToDeg,B is{parameter B,C is periapsis+body:radius,A is obt:eccentricity. return(C*(1+A))/(1+A*cos(B)).},F is{parameter F,G is periapsis+body:radius,D is obt:eccentricity. if D=0{if abs(F-G)<C return list(0,180).return list().}local B is((G*(1+D))/F-1)/D. if abs(B)>1if abs(B)-1<C set B to round(B).else{print"Error: TrueAnomaliesAtRadius cannot determine V from invalid orbital geometry".return list().}local A is arccos(B).if A<C return list(0).if D<1{if 180-A<C return list(180).return list(A,360-A).}return list(-A,A).}.export(lex("a",{parameter A,B,C is body. if A<0or B<0print"Error: SemiMajorAxis is only valid for elliptical orbits".return(A+B)/2+C:radius.},"Vlim",{parameter A is obt:eccentricity. if(A<1)return 180.return arccos(max(-1,-1/A)).},"Van",{parameter A is obt:argumentOfPeriapsis,B is obt:eccentricity. if B<1return mod(360-A,360).return-A.},"Vdn",{parameter A is obt:argumentOfPeriapsis,B is obt:eccentricity. if B<1return mod(540-A,360).return 180-A.},"Vr",B,"Vh",{parameter A,C is periapsis+body:radius,D is obt:eccentricity,F is body. return B(A,C,D)-F:radius.},"rV",F,"hV",{parameter A,B is periapsis+body:radius,C is obt:eccentricity,D is body. return F(A+D:radius,B,C).},"E",{parameter D,A is obt:eccentricity. if A>=1print"Error: EccentricAnomaly is only valid for elliptical orbits".local B is mod(D+360,360),C is arccos((A+cos(B))/(1+A*cos(B))).if(B>180)set C to 360-C. return C.},"F",{parameter B,C is obt:eccentricity. if C<=1print"Error: HyperbolicAnomaly is only valid for hyperbolic orbits".local A is D:acosh((C+cos(B))/(1+C*cos(B)))*A. if B<0return-A. return A.},"M",{parameter B,C is obt:eccentricity. if C>=1print"Error: MeanAnomaly is only valid for elliptical orbits".return B-C*sin(B)*A.},"Mh",{parameter F,B is obt:eccentricity. if B<=1print"Error: HyperbolicMeanAnomaly is only valid for hyperbolic orbits".local C is F*constant:degToRad. return(B*D:sinh(C)-C)*A.})).}