{local A is lex("Sun",0,"Kerbin",6760,"Mun",7057,"Minmus",5725,"Moho",6816,"Eve",7537,"Duna",8264,"Ike",12734,"Jool",0,"Laythe",6060,"Vall",7975,"Bop",21755,"Tylo",12894,"Gilly",6401,"Pol",4889,"Dres",5670,"Eeloo",3795,"Sarnus",0,"Hale",5918,"Ovok",14000,"Slate",16398,"Tekto",5873,"Urlum",0,"Polta",8649,"Priax",30483,"Wal",20773,"Tal",11777,"Neidon",0,"Thatmo",4825,"Nissee",8936,"Plock",3330,"Karen",4604).function B{parameter Z. if Z:istype("Body")return ApiOK(Z).else if Z:istype("string")and bodyExists(Z)return ApiOK(body(Z)).else return ApiFail(Z:tostring+" is not a valid Body").}function C{parameter Z,Y is true. local X is B(Z).if not X:ok return X. local W is X:val,U is W:name. if not A:haskey(U)return ApiFail(Z:tostring+" does not have a known maximum terrain height").return ApiOK(max(choose W:atm:height if Y and W:atm:exists else 0,A[U])).}export(lex("altitude",C@,"radius",{parameter Z,Y is true. local X is B(Z).if not X:ok return X. local W is X:val,U is C(W,Y).if not U:ok return U. return ApiOK(U:val+W:radius).})).}