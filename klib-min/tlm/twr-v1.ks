{local lock D to mass*body:mu/(body:radius+altitude)^2.local lock A to vang(up:vector,facing:vector).local B is{return availableThrust/D.},C is{return ship:thrust/D.}.export(lex("available",B,"vAvailable",{return B()*cos(A).},"hAvailable",{return B()*sin(A).},"current",C,"vCurrent",{return C()*cos(A).},"hCurrent",{return C()*sin(A).})).}