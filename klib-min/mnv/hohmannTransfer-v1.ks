{local C is import("mech/orbitalMechanics-v1"),L is import("mech/orbitalParameters-v1").export({parameter I.local B is I:orbit,D is B:semimajoraxis,F is obt:semimajoraxis,J is 360/B:period,A is mod(mod(B:lan+B:argumentofperiapsis+B:trueanomaly,360)+360-mod(obt:lan+obt:argumentofperiapsis+obt:trueanomaly,360),360),G is mod(180-J*C:P((D+F)/2)/2,360).if D<F{set A to A-360.if A>G set A to A-360.}if D>F and A<G set A to A+360.local K is time:seconds+mod(abs(A-G),360)/abs(360/obt:period-J),H is body:altitudeOf(positionAt(ship,K)).return ApiOK(node(K,0,0,C:v(H,L:a(H,I:orbit:semimajoraxis-body:radius))-C:v(H))).}).}