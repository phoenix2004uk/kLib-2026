{local A is import("mech/orbitalMechanics-v1"),B is import("mech/orbitalParameters-v1").export({parameter Z. local Y is Z:orbit,X is Y:semimajoraxis,W is obt:semimajoraxis,U is 360/Y:period,T is mod(mod(Y:lan+Y:argumentofperiapsis+Y:trueanomaly,360)+360-mod(obt:lan+obt:argumentofperiapsis+obt:trueanomaly,360),360),S is mod(180-U*A:P((X+W)/2)/2,360).if X<W{set T to T-360.if T>S set T to T-360.}if X>W and T<S set T to T+360.local P is time:seconds+mod(abs(T-S),360)/abs(360/obt:period-U),O is body:altitudeOf(positionAt(ship,P)).return ApiOK(node(P,0,0,A:v(O,B:a(O,Z:orbit:semimajoraxis-body:radius))-A:v(O))).}).}