{local LA is import("math-v1"),CA is constant:PI, CB is constant:DegToRad. function FA{parameter Z. return lex("valid",false,"reason",Z).}function FB{parameter Z. local Y is 1, X is 1. from{local W is 0.}until abs(X)<=1e-11 or W>=1e3 step{set W to W+1.}do{set X to X*(3+W)*(1+W)/(2.5+W)*Z/(W+1).set Y to Y+X.}return Y.}function FC{parameter Z,Y,X. local W is abs(Z-1),U is Y^2. if W<.2 and W>.01{local T is 1/(1-Z^2).if T>0{local S is 2*arccos(max(-1,min(1,Z)))*CB, P is 2*arcsin(sqrt(max(0,min(1,U/T))))*CB. if Y<0 set P to -P. return T*sqrt(T)*((S-sin(S*constant:RadToDeg))-(P-sin(P*constant:RadToDeg))+2*CA*X)/2.}local S is 2*LA:acosh(Z),P is 2*LA:asinh(sqrt(-U/T)).if Y<0 set P to -P. return -T*sqrt(-T)*((P-LA:sinh(P))-(S-LA:sinh(S)))/2.}local T is Z^2-1,S is abs(T),P is sqrt(max(0,1+U*T)).if W<.01{local O is P-Y*Z. return(O^3*(4/3*FB(.5*(1-Y-Z*O)))+4*Y*O)/2+X*CA/S^1.5.}local O is sqrt(S),N is Z*P-Y*T, M is 0. if T<0 set M to X*CA+arccos(max(-1,min(1,N)))*CB. else set M to ln(O*(P-Y*Z)+N).return(Z-Y*P-M/O)/T.}function FD{parameter Z,Y,X. local W is X^2, U is W*X, T is 1-Z^2, S is sqrt(1-W*T),P is S^3, O is(3*Y*Z-2+2*U*Z/S)/T, N is(3*Y+5*Z*O+2*(1-W)*U/P)/T. return V(O,N,(7*Z*N+8*O-6*(1-W)*W*U*Z/P/S^2)/T).}function FE{parameter Z,Y,X,W,U. local T is Y. from{local S is 0.}until S>=15 step{set S to S+1.}do{local P is FC(T,X,W),O is FD(T,P,X),N is P-Z, M is O:x, L is O:y, K is M^2, J is M*(K-N*L)+O:z*N^2/6.if abs(J)<1e-15 return FA("Lambert Householder denominator is singular").local I is T-N*(K-N*L/2)/J. if abs(T-I)<U return lex("valid",true,"x",I,"iterations",S+1).set T to I.}return FA("Lambert Householder iteration did not converge").}function FF{parameter Z,Y,X,W. if X<=0 return true. if X>floor(Z/CA)return false. local U is W+X*CA. if Z>=U return true. local T is 0. from{local S is 0.}until S>=13 step{set S to S+1.}do{local P is FD(T,U,Y),O is P:x, N is P:y, M is N^2-O*P:z/2.if abs(M)<1e-15 break. local L is T-O*N/M. if abs(T-L)<1e-13 break. set T to L. set U to FC(T,Y,X).}return Z>=U.}function FG{parameter Z,Y,X,W is "left".local U is Y^2, T is U*Y, S is arccos(max(-1,min(1,Y)))*CB+Y*sqrt(max(0,1-U)).if not FF(Z,Y,X,S)return FA("Requested Lambert revolution count has no solution").if X=0{local P is 2/3*(1-T),O is 0. if Z>=S set O to -(Z-S)/(Z-S+4).else if Z<=P set O to P*(P-Z)/((2/5)*(1-U*T)*Z)+1.else set O to(Z/S)^(ln(2)/ln(P/S))-1.return FE(Z,O,Y,0,1e-5).}if W<>"left" and W<>"right" return FA("Lambert multi-revolution branch must be left or right").local P is 0. if W="left" set P to((X*CA+CA)/(8*Z))^(2/3).else set P to(8*Z/(X*CA))^(2/3).return FE(Z,(P-1)/(P+1),Y,X,1e-8).}export({parameter Z,Y,X,W,U is "short",T is 0,S is "left",P is false. if X<=0 return FA("Lambert time of flight must be positive").if W<=0 return FA("Lambert gravitational parameter must be positive").if U<>"short" and U<>"long" return FA("Lambert direction must be short or long").if T<0 return FA("Lambert revolution count cannot be negative").local O is Z:mag, N is Y:mag. if O<=0 or N<=0 return FA("Lambert position vectors must be non-zero").local M is(Y-Z):mag. if M<=1e-9 return FA("Coincident Lambert endpoints are not supported").local L is(M+O+N)/2,K is Z/O, J is Y/N, I is max(0,min(1,1-M/L)),H is sqrt(I),G is -vcrs(K,J),F is false. if G:mag>1e-10 set F to G:normalized. else{if not P:istype("Vector")return FA("Lambert transfer plane is undefined; provide planeNormal").if P:mag<=1e-10 return FA("Lambert planeNormal must be non-zero").set F to P:normalized.}local E is(-vcrs(F,K)):normalized, D is(-vcrs(F,J)):normalized. if U="long"{set H to -H. set E to -E. set D to -D.}local C is sqrt(2*W/L^3)*X, B is FG(C,H,T,S).if not B:valid return B. local A is B:x, AA is sqrt(max(0,1-I+I*A^2)),AB is sqrt(W*L/2),AC is(O-N)/M, AD is H*AA-A, AE is H*AA+A, AF is AB*sqrt(max(0,1-AC^2))*(AA+H*A).return lex("valid",true,"departureVelocity",AB*(AD-AC*AE)/O*K+AF/O*E,"arrivalVelocity",-AB*(AD+AC*AE)/N*J+AF/N*D,"direction",U,"revolutions",T,"branch",S,"x",A,"y",AA,"lambda",H,"T",C,"chord",M,"semiperimeter",L,"iterations",B:iterations).}).}