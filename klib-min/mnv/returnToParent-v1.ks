{local A is import("mech/orbitalMechanics-v1"),B is import("mech/orbitalParameters-v1"),C is import("mnv/seekNode-v1").function D{parameter Z,Y is 0.local X is body:body,W is body:orbit:semimajoraxis-X:radius,U is obt:semimajoraxis,T is U-body:radius,S is -body:mu/(A:v(W,body:orbit:semimajoraxis,X)-A:v(W,B:a(W,Z,X),X))^2,P is B:Vlim(1-U/S),O is A:h(ship):normalized,N is vxcl(O,choose -body:velocity:orbit if Y=0 else -velocityAt(body,Y):orbit):normalized,M is N*cos(P)-vcrs(O,N)*sin(P),L is up:vector. set Y to time:seconds+A:dtV(mod(arctan2(vdot(vcrs(L,M),O),vdot(L,M))+360,360)).return node(Y,0,0,A:v(T,S,body)-A:v(T,U,body)).}export({parameter Z. local Y is D(Z,D(Z):time).add Y. local X is body:orbit:apoapsis+body:body:radius+body:soiradius,W is Z+body:body:radius. C(Y,list("prograde"),{parameter U. if not U:orbit:hasNextPatch return U:orbit:apoapsis+body:radius-X-body:soiradius. return W-U:orbit:nextPatch:periapsis-body:body:radius.}).if not Y:orbit:hasNextPatch return ApiFail("Failed to find an escape trajectory").local T is Y:orbit:nextPatch. if T:hasNextPatch and T:eta:transition<T:eta:periapsis return ApiFail("We will encounter another body before periapsis: "+T:nextPatch:body,true).return ApiOK().}).}