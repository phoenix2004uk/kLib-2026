{local A is import("mech/orbitalMechanics-v1"),G is import("mech/orbitalParameters-v1"),B is import("mnv/seekNode-v1").function H{parameter O,B is 0.local C is body:body,D is body:orbit:semimajoraxis-C:radius,F is obt:semimajoraxis,I is F-body:radius,J is-body:mu/(A:v(D,body:orbit:semimajoraxis,C)-A:v(D,G:a(D,O,C),C))^2,K is G:Vlim(1-F/J),G is A:h(ship):normalized,L is vxcl(G,choose-body:velocity:orbit if B=0else-velocityAt(body,B):orbit):normalized,M is L*cos(K)-vcrs(G,L)*sin(K),N is up:vector. set B to time:seconds+A:dtV(mod(arctan2(vcrs(N,M)*G,N*M)+360,360)).return node(B,0,0,A:v(I,J,body)-A:v(I,F,body)).}export({parameter C.local A is H(C,H(C):time).add A. local D is body:orbit:apoapsis+body:body:radius+body:soiradius,F is C+body:body:radius. B(A,list("prograde"),{parameter A.if not A:orbit:hasNextPatch return A:orbit:apoapsis+body:radius-D-body:soiradius. return F-A:orbit:nextPatch:periapsis-body:body:radius.}).if not A:orbit:hasNextPatch return ApiFail("Failed to find an escape trajectory").local B is A:orbit:nextPatch. if B:hasNextPatch and B:eta:transition<B:eta:periapsis return ApiFail("We will encounter another body before periapsis: "+B:nextPatch:body,true).return ApiOK().}).}