{local T is import("mnv/velocityChangeToNode-v1"),A is{parameter N,A,O.if A<=time:seconds return ApiFail("Maneuver UT must be in the future").local B is orbitAt(ship,A).if B:body<>body return ApiFail("Apsis maneuver must remain in the current SOI").if O and B:eccentricity>=1return ApiFail("Cannot preserve apoapsis on an open trajectory").local C is B:periapsis,J is N. if O set C to N,J to B:apoapsis. if C+body:radius<=0return ApiFail("Target periapsis radius must be positive").if J<C return ApiFail("Target apoapsis cannot be below target periapsis").local K is positionAt(ship,A)-body:position,L is velocityAt(ship,A):orbit,D is K:mag,F is C+body:radius,G is J+body:radius. if D<F or D>G return ApiFail("Burn position is outside the target orbit apsides").local M is K:normalized,H is vxcl(M,L).if H:mag<1e-9return ApiFail("Orbital plane is undefined at the burn position").set H to H:normalized. local P is sqrt(2*body:mu*F*G/(F+G))/D,I is 2*body:mu*(1/D-1/(F+G))-P^2.if I<0if I>-1e-3set I to 0.else return ApiFail("Target orbit is unreachable from the burn position").local S is 1.if L*M<0set S to-1.return ApiOK(T(A,K,L,M*S*sqrt(I)+H*P)).}.export(lex("Pe",{parameter B,C.return A(B,C,true).},"Ap",{parameter B,C.return A(B,C,false).})).}