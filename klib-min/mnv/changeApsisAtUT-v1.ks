{local A is import("mnv/velocityChangeToNode-v1"),B is{parameter Z,Y,X. if Y<=time:seconds return ApiFail("Maneuver UT must be in the future").local W is orbitAt(ship,Y).if W:body<>body return ApiFail("Apsis maneuver must remain in the current SOI").if X and W:eccentricity>=1 return ApiFail("Cannot preserve apoapsis on an open trajectory").local U is W:periapsis,T is Z. if X{set U to Z. set T to W:apoapsis.}if U+body:radius<=0 return ApiFail("Target periapsis radius must be positive").if T<U return ApiFail("Target apoapsis cannot be below target periapsis").local S is positionAt(ship,Y)-body:position,P is velocityAt(ship,Y):orbit,O is S:mag,N is U+body:radius,M is T+body:radius. if O<N or O>M return ApiFail("Burn position is outside the target orbit apsides").local L is S:normalized,K is vxcl(L,P).if K:mag<1e-9 return ApiFail("Orbital plane is undefined at the burn position").set K to K:normalized. local J is sqrt(2*body:mu*N*M/(N+M))/O,I is 2*body:mu*(1/O-1/(N+M))-J^2.if I<0{if I>-1e-3 set I to 0.else return ApiFail("Target orbit is unreachable from the burn position").}local H is 1.if vdot(P,L)<0 set H to-1.return ApiOK(A(Y,S,P,L*H*sqrt(I)+K*J)).}.export(lex("Pe",{parameter Z,Y. return B(Z,Y,true).},"Ap",{parameter Z,Y. return B(Z,Y,false).})).}