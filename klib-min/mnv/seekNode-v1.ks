{local F is{parameter A,B,C,D.set A:eta to B[0]+(C[0]*D)-time:seconds,A:radialout to B[1]+(C[1]*D),A:normal to B[2]+(C[2]*D),A:prograde to B[3]+(C[3]*D).}.export({parameter A,B,J,L is 2,M is-2.local C is list(),D is uniqueset(),G is B:contains("time"),H is B:contains("radial"),I is B:contains("normal"),K is B:contains("prograde").for A in range(0,81){local A is list(choose mod(floor(A/27)+1,3)-1if G else 0,choose mod(floor(A/9)+1,3)-1if H else 0,choose mod(floor(A/3)+1,3)-1if I else 0,choose mod(A+1,3)-1if K else 0),B is A:join(",").if not D:contains(B){D:add(B).C:add(A).}}for B in range(L,M-1){local H is 10^B,B is-1,G is 3e30.until B=0{set B to 0.local I is list(time:seconds+A:eta,A:radialout,A:normal,A:prograde),D is C:iterator. until not D:next{F(A,I,D:value,H).local A is J(A).if abs(A)<G set G to abs(A),B to D:index.}F(A,I,C[B],H).wait 0.}}}).}