{local A is list(0,1,-1).function B{parameter Z,Y,X,W. set Z:eta to Y[0]+(X[0]*W)-time:seconds. set Z:radialout to Y[1]+(X[1]*W).set Z:normal to Y[2]+(X[2]*W).set Z:prograde to Y[3]+(X[3]*W).}.export({parameter Z,Y,X,W is 2,U is -2.local T is list(),S is uniqueset(),P is Y:contains("time"),O is Y:contains("radial"),N is Y:contains("normal"),M is Y:contains("prograde").for L in range(0,81){local K is list(choose A[mod(floor(L/27)+3,3)]if P else 0,choose A[mod(floor(L/9)+3,3)]if O else 0,choose A[mod(floor(L/3)+3,3)]if N else 0,choose A[mod(L+3,3)]if M else 0),J is K:join(",").if not S:contains(J){S:add(J).T:add(K).}}for L in range(W,U-1){local K is 10^L,J is -1,I is 3e30.until J=0{set J to 0.local H is list(time:seconds+Z:eta,Z:radialout,Z:normal,Z:prograde),G is T:iterator. until not G:next{B(Z,H,G:value,K).local F is X(Z).if abs(F)<I {set I to abs(F).set J to G:index.}}B(Z,H,T[J],K).wait 0.}}}).}