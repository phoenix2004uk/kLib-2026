{local D is import("mnv/velocityChangeToNode-v1").export({parameter A.if A>=time:seconds+eta:transition return ApiFail("Targeted burn time is outside the current orbit patch").if A<time:seconds return ApiFail("Targeted burn time is in the past").local B is positionAt(ship,A)-body:position,C is velocityAt(ship,A):orbit. return ApiOK(D(A,B,C,vxcl(B:normalized,C):normalized*sqrt(body:mu/B:mag))).}).}