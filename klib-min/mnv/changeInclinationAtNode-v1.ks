{local I is import("mech/orbitalParameters-v1"),L is import("mech/orbitalMechanics-v1"),W is import("mnv/velocityChangeToNode-v1"),A is{parameter B,M,N is.25.local J is M-obt:inclination. if abs(J)<=N return ApiOK(node(time:seconds,0,0,0),"Inclination is within "+N+"° limit of "+M+"°: "+obt:inclination+"°").if obt:eccentricity=1return ApiFail("Parabolic trajectories are not supported").local H is B,A is lex(),K is obt:eccentricity<1,O is I:Van(),P is I:Vdn(),S is I:Vlim(),C is K or abs(O)<S,D is K or abs(P)<S,F is 0,G is 0,T is time:seconds. if C{if K set F to L:etaAN().else set F to L:etaANh().if F<0or F>eta:transition set C to false. else set A["AN"]to T+F.}if D{if K set G to L:etaDN().else set G to L:etaDNh().if G<0or G>eta:transition set D to false. else set A["DN"]to T+G.}if C and not D set A["next"]to"AN",A["last"]to"AN",A["high"]to"AN",A["low"]to"AN".if D and not C set A["next"]to"DN",A["last"]to"DN",A["high"]to"DN",A["low"]to"DN".if C and D{if F<=G set A["next"]to"AN",A["last"]to"DN".else set A["next"]to"DN",A["last"]to"AN".if I:Vr(O)<=I:Vr(P)set A["low"]to"AN",A["high"]to"DN".else set A["low"]to"DN",A["high"]to"AN".}if not(C or D)return ApiFail("There is no AN or DN on the current trajectory").if B<>"AN"and B<>"DN"if A:hasKey(B)set H to A[B].else return ApiFail("Not a valid node selection: "+B).if not A:hasKey(H)return ApiFail(H+" is undefined on the current trajectory").if H="DN"set J to-J. local I is A[H],L is positionAt(ship,I),U is velocityAt(ship,I):orbit. return ApiOK(W(I,L-body:position,U,angleAxis(-J,(L-body:position):normalized)*U)).}.export(lex("AN",A:bind("AN"),"DN",A:bind("DN"),"next",A:bind("next"),"last",A:bind("last"),"highest",A:bind("high"),"lowest",A:bind("low"))).}