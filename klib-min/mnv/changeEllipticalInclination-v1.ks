{local A is import("mech/orbitalParameters-v1"),B is import("mech/orbitalMechanics-v1"),C is import("mnv/velocityChangeToNode-v1"),D is{parameter Z,Y,X,W is false. if obt:inclination>=Z-X and obt:inclination<=Z+X return ApiOK(node(time:seconds,0,0,0),"Inclination is within "+X+"° limit of "+Z+"°: "+obt:inclination+"°").if obt:eccentricity>=1 return ApiFail("Change inclination is not supported on an open orbit: e="+round(obt:eccentricity,4)).local U is Z-obt:inclination. if W set U to-U. local T is positionAt(ship,Y),S is velocityAt(ship,Y):orbit. return ApiOK(C(Y,T-body:position,S,angleAxis(-U,(T-body:position):normalized)*S)).}.export(lex("AN",{parameter Z,X is .25.return D(Z,time:seconds+B:etaAN(),X).},"DN",{parameter Z,X is .25.return D(Z,time:seconds+B:etaDN(),X,true).},"next",{parameter Z,X is .25.local P is time:seconds+B:etaAN(),O is time:seconds+B:etaDN().if O<P return D(Z,O,X,true).return D(Z,P,X,false).},"highest",{parameter Z,X is .25.local N is A:Van(),M is A:Vdn().if A:Vr(M)>A:Vr(N)return D(Z,time:seconds+B:etaV(M),X,true).return D(Z,time:seconds+B:etaV(N),X).})).}