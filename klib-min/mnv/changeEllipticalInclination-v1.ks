{local C is import("mech/orbitalParameters-v1"),B is import("mech/orbitalMechanics-v1"),H is import("mnv/velocityChangeToNode-v1"),A is{parameter A,B,C,I is false. if obt:inclination>=A-C and obt:inclination<=A+C return ApiOK(node(time:seconds,0,0,0),"Inclination is within "+C+"° limit of "+A+"°: "+obt:inclination+"°").if obt:eccentricity>=1return ApiFail("Change inclination is not supported on an open orbit: e="+round(obt:eccentricity,4)).local F is positionAt(ship,B),G is velocityAt(ship,B):orbit,D is A-obt:inclination. if I set D to-D. return ApiOK(H(B,F-body:position,G,angleAxis(-D,(F-body:position):normalized)*G)).}.export(lex("AN",{parameter C,D is.25.return A(C,time:seconds+B:etaAN(),D).},"DN",{parameter C,D is.25.return A(C,time:seconds+B:etaDN(),D,true).},"next",{parameter C,D is.25.local F is time:seconds+B:etaAN(),B is time:seconds+B:etaDN().if B<F return A(C,B,D,true).return A(C,F,D,false).},"highest",{parameter D,F is.25.local G is C:Van(),H is C:Vdn().if C:Vr(H)>C:Vr(G)return A(D,time:seconds+B:etaV(H),F,true).return A(D,time:seconds+B:etaV(G),F).})).}