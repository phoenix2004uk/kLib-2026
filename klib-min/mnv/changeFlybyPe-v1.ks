{local O is import("mnv/velocityChangeToNode-v1").export({parameter I,D is 60,J is 100.local A is time:seconds+D. if(abs(obt:periapsis-I)<=J)return ApiOK(node(A,0,0,0),"Fly-by periapsis is within limit ("+round(J,0)+"): "+round(obt:periapsis,1)).if obt:eccentricity<=1return ApiFail("Error: changeFlybyPeriapsis requires a hyperbolic trajectory.").if eta:periapsis<=D return ApiFail("Fly-by trim maneuver must be performed before periapsis; lead time = "+D).local F is positionAt(ship,A)-body:position,G is velocityAt(ship,A):orbit,H is F:mag,K is G:mag,B is I+body:radius. if B>H return ApiFail("Target periapsis is above the burn position").local L is B*(K^2*B+2*body:mu*(1-B/H)).if L<0return ApiFail("Target periapsis is unreachable at current orbital energy").local M is F:normalized,N is sqrt(L)/H,C is K^2-N^2.if C<0if C>-.001set C to 0.else return ApiFail("Target periapsis is unreachable from the burn position at current orbital energy").return ApiOK(O(A,F,G,M*-sqrt(C)+vxcl(M,G):normalized*N)).}).}