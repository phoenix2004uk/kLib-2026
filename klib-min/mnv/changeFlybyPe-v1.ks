{local A is import("mnv/velocityChangeToNode-v1").export({parameter Z,Y is 60,X is 100.local W is time:seconds+Y. if (abs(obt:periapsis-Z)<=X)return ApiOK(node(W,0,0,0),"Fly-by periapsis is within limit ("+round(X,0)+"): "+round(obt:periapsis,1)).if obt:eccentricity<=1 return ApiFail("Error: changeFlybyPeriapsis requires a hyperbolic trajectory.").if eta:periapsis<=Y return ApiFail("Fly-by trim maneuver must be performed before periapsis; lead time = "+Y).local U is positionAt(ship,W)-body:position,T is velocityAt(ship,W):orbit,S is U:mag,P is T:mag,O is Z+body:radius. if O>S return ApiFail("Target periapsis is above the burn position").local N is O*(P^2*O+2*body:mu*(1-O/S)).if N<0 return ApiFail("Target periapsis is unreachable at current orbital energy").local M is U:normalized,L is sqrt(N)/S,K is P^2-L^2.if K<0{if K>-0.001 set K to 0.else return ApiFail("Target periapsis is unreachable from the burn position at current orbital energy").}return ApiOK(A(W,U,T,M*-sqrt(K)+vxcl(M,T):normalized*L)).}).}