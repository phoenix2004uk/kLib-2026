{local A is import("mech/orbitalParameters-v1"),C is import("mech/orbitalMechanics-v1"),G is import("mnv/circularizeAtUT-v1").export({parameter H.if obt:eccentricity=1return ApiFail("Parabolic trajectories are not supported").local B is A:hV(H).if B:length=0return ApiFail("Targeted burn altitude does not exist on the current orbit").local A is list(),F is 0,D is list().for F in B{local B is time:seconds. if obt:eccentricity<1set B to B+C:etaV(F).else set B to B+C:etaVh(F).local C is G(B).if C:ok A:add(C).else D:add(C).}set F to A:length. for B in D A:add(B).if F>0return ApiOK(A).return ApiFail("Unable to plot any valid maneuvers for the targeted burn altitude",A).}).}