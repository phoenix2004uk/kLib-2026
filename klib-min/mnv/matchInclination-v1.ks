{local C is import("mech/orbitalMechanics-v1"),J is import("mech/orbitalParameters-v1"),T is import("mnv/velocityChangeToNode-v1").export({parameter N is target,B is"first",O is.01.local D is vang(C:h(ship),C:h(N)).if D<O return ApiOK(node(time:seconds,0,0,0),"Relative inclination is within limit ("+round(O,4)+"): "+round(D,4)).local F is"",K is ship:position-body:position,P is C:h(ship),L is vcrs(P,C:h(N)):normalized,G is vang(L,K),H is vang(-L,K),A is lex().if vang(K,vcrs(P,L):normalized)>90set H to H+2*G,A["first"]to"AN",A["last"]to"DN".else set G to G+2*H,A["first"]to"DN",A["last"]to"AN".set A["AN"]to obt:trueanomaly+G,A["DN"]to obt:trueanomaly+H. if obt:eccentricity<1set A["AN"]to mod(360+A["AN"],360),A["DN"]to mod(360+A["DN"],360).if abs(J:Vr(A["AN"]))<abs(J:Vr(A["DN"]))set A["low"]to"AN",A["high"]to"DN".else set A["low"]to"DN",A["high"]to"AN".if B="AN"or B="DN"set F to B. else if A:haskey(B)set F to A[B].else return ApiFail("Not a valid node selection: "+B).local I is A[F],M is 0.if obt:eccentricity<1set M to C:etaV(I).else{if(I<-abs(J:Vlim())or I>abs(J:Vlim()))return ApiFail("The trueanomaly is beyond the hyperbolic limit for the selected node: "+F).set M to C:etaVh(I).}local C is time:seconds+M,J is positionAt(ship,C),S is velocityAt(ship,C):orbit. if F="DN"set D to-D. return ApiOK(T(C,J-body:position,S,angleAxis(D,(J-body:position):normalized)*S),"Maneuver planned").}).}