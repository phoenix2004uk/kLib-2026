{local A is import("orbitalMechanics-v1"),B is import("orbitalParameters-v1"),C is import("mnv/velocityChangeToNode-v1").export({parameter Z is target,Y is"first",X is 1e-2. local W is vang(A:h(ship),A:h(Z)).if W<X return ApiOK(node(time:seconds,0,0,0),"Relative inclination is within limit ("+round(X,4)+"): "+round(W,4)).local U is"",T is ship:position-body:position,S is A:h(ship),P is vcrs(S,A:h(Z)):normalized,O is vang(P,T),N is vang(-P,T),M is lex().if vang(T,vcrs(S,P):normalized)>90{set N to N+2*O. set M["first"]to"AN".set M["last"]to"DN".}else{set O to O+2*N. set M["first"]to"DN".set M["last"]to"AN".}set M["AN"]to ship:orbit:trueanomaly+O. set M["DN"]to ship:orbit:trueanomaly+N. if orbit:eccentricity<1{set M["AN"]to mod(360+M["AN"],360).set M["DN"]to mod(360+M["DN"],360).}if abs(B:Vr(M["AN"]))<abs(B:Vr(M["DN"])){set M["low"]to"AN".set M["high"]to"DN".}else{set M["low"]to"DN".set M["high"]to"AN".}if Y="AN"or Y="DN"set U to Y. else if M:haskey(Y)set U to M[Y].else return ApiFail("Not a valid node selection: "+Y).local L is M[U],K is 0. if orbit:eccentricity<1 set K to A:etaV(L).else{if (L<-abs(B:Vlim())or L>abs(B:Vlim()))return ApiFail("The trueanomaly is beyond the hyperbolic limit for the selected node: "+U).set K to A:etaVh(L).}local J is time:seconds+K,I is positionAt(ship,J),H is velocityAt(ship,J):orbit. if U="DN"set W to -W. return ApiOK(C(J,I-body:position,H,angleAxis(W,(I-body:position):normalized)*H),"Maneuver planned").}).}