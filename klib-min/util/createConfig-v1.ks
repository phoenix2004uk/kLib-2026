{export({parameter B,C is lex().local A is lex(),D is"Configuration ",F is" must be a Lexicon".if B:istype("Lexicon"){if C:istype("Lexicon"){for C in B:keys A:add(C,B[C]).for B in C:keys{if not A:haskey(B)return ApiFail("Unknown configuration option: "+B).set A[B]to C[B].}return ApiOK(A).}return ApiFail(D+"options"+F).}return ApiFail(D+"defaults"+F).}).}