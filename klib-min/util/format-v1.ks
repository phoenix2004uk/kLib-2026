{local F is list(9201600,21600,3600,60),G is list("mm","cm","m","km","Mm","Gm","Tm"),H is list("N","kN","MN"),I is list("g","kg","t","kt","Mt"),A is{parameter C.local A is abs(C),B is choose 0if A<.01else choose 1if A<1else 2+min(4,ceiling(log10(max(A,2e3)/2e3)/3)),D is C/10^max(B-3,3*B-6).return round(D,max(0,floor(log10(2e3/max(abs(D),20)))))+G[B].},B is{parameter A.local B is abs(A),C is choose 0if B<1else 1+min(1,ceiling(log10(max(B,2e3)/2e3)/3)),D is A/10^(3*(C-1)).return round(D,max(0,floor(log10(2e3/max(abs(D),20)))))+H[C].}.export(lex("time",{parameter C.local A is round(abs(C),2),B is"".for C in range(4){local D is floor(A/F[C]).if B or D set B to B+D+"ydhm"[C]+" ".set A to A-D*F[C].}return(choose"-"if C<0else"")+B+(choose"0"if B and A<10else"")+"{0:0.00}s":format(A).},"distance",A,"force",B,"weight",B,"mass",{parameter B.local A is abs(B),C is choose 0if A<.001else choose 1if A<1else 2+min(2,ceiling(log10(max(A,2e3)/2e3)/3)),D is B/10^(3*(C-2)).return round(D,max(0,floor(log10(2e3/max(abs(D),20)))))+I[C].},"speed",{parameter B.return A(B)+"/s".},"acceleration",{parameter B.return A(B)+"/s²".},"angle",{parameter A.return round(A,4)+"°".})).}