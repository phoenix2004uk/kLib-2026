{function A{parameter Z. local Y is Z. if Z:istype("Body"){if not Z:hasorbit return ApiFail("The root body does not have an orbit").set Y to Z:orbit.}if Z:istype("Vessel")set Y to Z:orbit. if not Y:istype("Orbit")return ApiFail("An Orbit, Vessel or Body must be specified").local X is lex(),W is Y:eccentricity,U is Y:velocity,T is"Infinity",S is"Infinity".if Y:transition<>"INITIAL"and Y:transition<>"FINAL"{set T to Y:nextpatcheta. set S to time:seconds+T.}X:add("name",Z:tostring).X:add("virtual",choose"maybe"if Y:trueanomaly=0 else"no").X:add("a",Y:semimajoraxis).X:add("b",choose"Infinity"if W=1 else Y:semiminoraxis).X:add("e",W).X:add("i",Y:inclination).X:add("Ω",Y:lan).X:add("w",Y:argumentofperiapsis).X:add("Ap",choose Y:apoapsis if W<1 else"Infinity").X:add("Pe",Y:periapsis).X:add("t0",Y:epoch).X:add("M0",Y:meananomalyatepoch).X:add("V0",Y:trueanomaly).X:add("P",choose Y:period if W<1 else"Infinity").X:add("body",Y:body:name).X:add("transition",Y:transition).X:add("position",Y:position).X:add("velocity:orbit",U:orbit).X:add("velocity:surface",U:surface).X:add("transitioneta",T).X:add("transitionat",S).X:add("hasnextpatch",Y:hasnextpatch).return ApiOK(X).}function B{parameter Z. local Y is A(Z).if Y:ok{local X is list(),W is 0. for U in Y:val:keys set W to max(W,U:length).for U in Y:val:keys X:add(U:padright(W)+" = "+Y:val[U]).return ApiOK(X).}return Y.}export(lex("lex",A@,"lines",B@,"print",{parameter Z,Y is{parameter X. print X.}.local W is B(Z).if W:ok for X in W:val Y(X).else Y(W:msg).})).}