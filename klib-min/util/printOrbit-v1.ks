{local D is"Infinity",B is{parameter C.local A is C. if C:istype("Body"){if not C:hasorbit return ApiFail("The root body does not have an orbit").set A to C:orbit.}if C:istype("Vessel")set A to C:orbit. if not A:istype("Orbit")return ApiFail("An Orbit, Vessel or Body must be specified").local B is lex(),F is A:eccentricity,H is A:velocity,G is D,I is D. if A:transition<>"INITIAL"and A:transition<>"FINAL"set G to A:nextpatcheta,I to time:seconds+G. B:add("name",C:tostring).B:add("virtual",(choose"maybe"if A:trueanomaly=0else"no")).B:add("a",A:semimajoraxis).B:add("b",choose D if F=1else A:semiminoraxis).B:add("e",F).B:add("i",A:inclination).B:add("Ω",A:lan).B:add("w",A:argumentofperiapsis).B:add("Ap",choose A:apoapsis if F<1else D).B:add("Pe",A:periapsis).B:add("t0",A:epoch).B:add("M0",A:meananomalyatepoch).B:add("V0",A:trueanomaly).B:add("P",choose A:period if F<1else D).B:add("body",A:body:name).B:add("transition",A:transition).B:add("position",A:position).B:add("velocity:orbit",H:orbit).B:add("velocity:surface",H:surface).B:add("transitioneta",G).B:add("transitionat",I).B:add("hasnextpatch",A:hasnextpatch).return ApiOK(B).},A is{parameter C.local A is B(C).if A:ok{local B is A:val,C is list(),A is 0.for B in B:keys set A to max(A,B:length).for D in B:keys C:add(D:padright(A)+" = "+B[D]).return ApiOK(C).}return A.}.export(lex("lex",B,"lines",A,"print",{parameter C,B is{parameter A.print A.}.local A is A(C).if A:ok for A in A:val B(A).else B(A:msg).})).}