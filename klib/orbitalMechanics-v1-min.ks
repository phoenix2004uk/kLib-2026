{local A is import("OrbitalParameters-v1").function B{parameter Z is altitude,Y is orbit:semimajoraxis,X is body. return sqrt(X:mu*(2/(Z+X:radius)-1/Y)).}function C{parameter Z is orbit:semimajoraxis,Y is body. if Z<=0 print"Error: OrbitalPeriod is only valid for elliptical orbits".return 2*constant:pi*sqrt(Z^3/Y:mu).}function D{parameter Z,Y is orbit:period,X is orbit:trueanomaly,W is orbit:eccentricity. if W>=1{print"Error: TrueAnomalyEta is only valid for elliptical orbits".return false.}local T is mod(360+A:M(A:E(Z,W),W)-A:M(A:E(X,W),W),360).if T<1e-9 or 360-T<1e-9 set T to 0. return Y*T/360.}function E{parameter Z,Y is orbit:period,X is orbit:trueanomaly,W is orbit:eccentricity. if W>=1{print"Error: TrueAnomalyArcTime is only valid for elliptical orbits".return false.}local T is choose ceiling(Z/360)if Z<0 else floor(Z/360).local S is Z-T*360. local P is A:M(A:E(mod(360+X+S,360),W),W)-A:M(A:E(X,W),W).if S>0 and P<0 set P to P+360. if S<0 and P>0 set P to P-360.return Y*(T+P/360).}function F{parameter Z,Y is orbit:trueanomaly,X is orbit:semimajoraxis,W is orbit:eccentricity,T is body. if W<=1{print"Error: TrueAnomalyEtaHyperbolic is only valid for hyperbolic orbits.".return false.}local S is A:Mh(A:F(Z,W),W)-A:Mh(A:F(Y,W),W).if abs(S)<1e-9 set S to 0.return S*constant:radToDeg/sqrt(T:mu/(-X)^3).}export(lex("v",B@,"vh",{parameter Z,Y,X,U is body. return U(Z,A:a(Y,X,U),U).},"Ve",{parameter Z is body,Y is altitude. return sqrt(2*Z:mu/(Y+Z:radius)).},"P",C@,"Ph",{parameter Z,Y,X is body. return C(A:a(Z,Y,X),X).},"etaV",D@,"dtV",E@,"etaAN",{parameter Z is orbit:argumentOfPeriapsis,Y is orbit:period,X is orbit:trueanomaly,U is orbit:eccentricity. return D(A:Van(Z,U),Y,X,U).},"etaDN",{parameter Z is orbit:argumentOfPeriapsis,Y is orbit:period,X is orbit:trueanomaly,U is orbit:eccentricity. return D(A:Vdn(Z,U),Y,X,U).},"etaVh",F@,"etaANh",{parameter Z is orbit:argumentOfPeriapsis,Y is orbit:trueanomaly,X is orbit:semimajoraxis,U is orbit:eccentricity,T is body. return F(X:Van(Z,U),Y,X,U,T).},"etaDNh",{parameter Z is orbit:argumentOfPeriapsis,Y is orbit:trueanomaly,X is orbit:semimajoraxis,U is orbit:eccentricity,T is body. return F(X:Vdn(Z,U),Y,X,U,T).})).}