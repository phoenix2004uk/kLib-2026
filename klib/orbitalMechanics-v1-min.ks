{local A is import("OrbitalParameters-v1").function B{parameter Z is altitude,Y is orbit:semimajoraxis,X is body. return sqrt(X:mu*(2/(Z+X:radius)-1/Y)).}function C{parameter Z is orbit:semimajoraxis,Y is body. if Z<=0 print"Error: OrbitalPeriod is only valid for elliptical orbits".return 2*constant:pi*sqrt(Z^3/Y:mu).}function D{parameter Z,Y is orbit:period,X is orbit:trueanomaly,U is orbit:eccentricity. if U>=1 print"Error: TrueAnomalyEta is only valid for elliptical orbits".local T is Y*(A:M(A:E(Z,U),U)-A:M(A:E(X,U),U))/360.if T<0 return T+Y. return T.}function E{parameter Z,Y is orbit:trueanomaly,X is orbit:semimajoraxis,U is orbit:eccentricity,T is body. if U<=1 print"Error: TrueAnomalyEtaHyperbolic is only valid for hyperbolic orbits.".return(A:Mh(A:F(Z,U),U)-A:Mh(A:F(Y,U),U))/(sqrt(T:mu/(-X)^3)*constant:radToDeg).}export(lex("v",B@,"vh",{parameter Z,Y,X,U is body. return U(Z,A:a(Y,X,U),U).},"Ve",{parameter Z is body,Y is altitude. return sqrt(2*Z:mu/(Y+Z:radius)).},"P",C@,"Ph",{parameter Z,Y,X is body. return C(A:a(Z,Y,X),X).},"etaV",D@,"etaAN",{parameter Z is orbit:argumentOfPeriapsis,Y is orbit:period,X is orbit:trueanomaly,U is orbit:eccentricity. return D(A:Van(Z,U),Y,X,U).},"etaDN",{parameter Z is orbit:argumentOfPeriapsis,Y is orbit:period,X is orbit:trueanomaly,U is orbit:eccentricity. return D(A:Vdn(Z,U),Y,X,U).},"etaVh",E@,"etaANh",{parameter Z is orbit:argumentOfPeriapsis,Y is orbit:trueanomaly,X is orbit:semimajoraxis,U is orbit:eccentricity,T is body. return E(X:Van(Z,U),Y,X,U,T).},"etaDNh",{parameter Z is orbit:argumentOfPeriapsis,Y is orbit:trueanomaly,X is orbit:semimajoraxis,U is orbit:eccentricity,T is body. return E(X:Vdn(Z,U),Y,X,U,T).})).}